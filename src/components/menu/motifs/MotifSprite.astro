<style>
  .motif-sprite {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }
  /* Dots (seeds, spice) are filled; everything else inherits stroke-only from <use>. */
  .motif-fill {
    fill: currentColor;
    stroke: none;
  }
</style>
