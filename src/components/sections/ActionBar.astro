---
import Icon from '../ui/Icon.astro';
import { business } from '../../data/business';
---

<nav class="actionbar" aria-label="Brze akcije" data-actionbar>
  <a href={business.phone.tel}><Icon name="phone" /><span>Pozovi</span></a>
  <a href="#rezervacija" data-action-reserve><Icon name="chat" /><span>Rezerviši</span></a>
  <a href="#meni"><Icon name="plate" /><span>Meni</span></a>
</nav>

<style>
  .actionbar {
    position: fixed;
    inset: auto 0 0;
    z-index: var(--z-actionbar);
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding: 6px 8px calc(6px + env(safe-area-inset-bottom));
    background: rgb(18 17 16 / 0.94);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgb(242 232 213 / 0.12);
    transition: transform 320ms var(--ease-out);
  }
  .actionbar.is-hidden,
  :global(html.intro-on) .actionbar,
  :global(html.menu-open) .actionbar,
  :global(html.lightbox-open) .actionbar {
    transform: translateY(110%);
  }
  .actionbar a {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-height: 52px;
    padding-top: 6px;
    border-radius: var(--radius-m);
    color: var(--dough);
    font-size: var(--fs-micro);
    font-weight: 650;
    text-decoration: none;
  }
  .actionbar a:active {
    background: rgb(242 232 213 / 0.08);
  }
  .actionbar a[data-action-reserve] {
    color: #fff;
    background: var(--tomato);
  }
  @media (min-width: 60rem) {
    .actionbar {
      display: none;
    }
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-actionbar]')!;
  let lastY = scrollY;
  let lastT = performance.now();
  let stopTimer = 0;
  let typing = false;

  // Hide while scrolling down fast; show on scroll up or when scrolling stops.
  addEventListener(
    'scroll',
    () => {
      const y = scrollY;
      const t = performance.now();
      const v = (y - lastY) / Math.max(1, t - lastT); // px/ms
      if (!typing) {
        if (v > 0.6 && y > 200) bar.classList.add('is-hidden');
        else if (v < -0.15) bar.classList.remove('is-hidden');
      }
      lastY = y;
      lastT = t;
      clearTimeout(stopTimer);
      stopTimer = window.setTimeout(() => !typing && bar.classList.remove('is-hidden'), 220);
    },
    { passive: true },
  );

  // Never cover form fields while the on-screen keyboard is open.
  const isField = (el: EventTarget | null) => el instanceof HTMLElement && el.matches('input, textarea, select');
  addEventListener('focusin', (e) => {
    if (isField(e.target)) {
      typing = true;
      bar.classList.add('is-hidden');
    }
  });
  addEventListener('focusout', (e) => {
    if (isField(e.target)) {
      typing = false;
      setTimeout(() => !typing && bar.classList.remove('is-hidden'), 250);
    }
  });
</script>
