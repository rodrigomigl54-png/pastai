---
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import { business } from '../../data/business';

const year = new Date().getFullYear();
---

<footer class="footer theme-ink">
  <div class="container footer__grid">
    <div class="footer__brand">
      <div class="footer__logo"><Logo variant="compact" label="Pastai" /></div>
      <p>{business.tagline}</p>
    </div>
    <div>
      <h2 class="footer__h">Radno vreme</h2>
      <p>Pon–čet i ned: 08:00–23:00</p>
      <p>Pet–sub: 08:00–01:00</p>
    </div>
    <div>
      <h2 class="footer__h">Kontakt</h2>
      <p>{business.address.street}, {business.address.city}</p>
      <p><a href={business.phone.tel}>{business.phone.display}</a></p>
      <div class="footer__social">
        <a href={business.links.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
        <a href={business.links.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>
        <a href={business.links.wolt} target="_blank" rel="noopener" aria-label="Wolt dostava"><Icon name="bag" /></a>
      </div>
    </div>
  </div>
  <div class="container footer__legal">
    <p>© {year} {business.name}</p>
  </div>
</footer>

<style>
  .footer {
    padding: var(--space-xl) 0 calc(var(--space-l) + var(--actionbar-h) + env(safe-area-inset-bottom));
    border-top: 1px solid var(--rule);
    font-size: var(--fs-small);
  }
  .footer__grid {
    display: grid;
    gap: var(--space-l);
  }
  .footer__logo {
    width: 120px;
    margin-bottom: var(--space-xs);
  }
  .footer__brand p,
  .footer p {
    color: var(--fg-muted);
  }
  .footer__h {
    margin-bottom: var(--space-2xs);
    font-family: var(--font-sans);
    font-size: var(--fs-micro);
    font-weight: 700;
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--accent-2-text);
  }
  .footer a {
    color: var(--fg);
  }
  .footer__social {
    display: flex;
    gap: var(--space-2xs);
    margin-top: var(--space-xs);
  }
  .footer__social a {
    display: grid;
    place-items: center;
    width: var(--tap-min);
    height: var(--tap-min);
    border: 1px solid var(--rule);
    border-radius: 50%;
  }
  .footer__legal {
    margin-top: var(--space-l);
    padding-top: var(--space-s);
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: 1.4fr 1fr 1fr;
    }
  }
  @media (min-width: 60rem) {
    .footer {
      padding-bottom: var(--space-l);
    }
  }
</style>
