---
import Photo from '../ui/Photo.astro';
import DoughNest from '../ui/DoughNest.astro';
import Icon from '../ui/Icon.astro';
import { gardenPhoto } from '../../data/gallery';
---

<section class="section garden theme-dough" id="basta" aria-labelledby="basta-title">
  <div class="container garden__grid">
    <div class="garden__art">
      {
        gardenPhoto ? (
          <Photo file={gardenPhoto} alt="Bašta restorana Pastai" sizes="(min-width: 60rem) 34rem, 92vw" class="garden__photo" />
        ) : (
          // TODO: garden photo from the owner (set gardenPhoto in src/data/gallery.ts)
          <div class="garden__placeholder">
            <DoughNest loops={4} seed={3} class="garden__nest" />
            <Icon name="sun" size={40} class="garden__sun" />
          </div>
        )
      }
    </div>
    <div>
      <p class="eyebrow">Bašta</p>
      <h2 id="basta-title">Pasta na otvorenom</h2>
      <p class="garden__lead">
        Kada je lepo vreme, sedite napolju, u našoj bašti na Trgu republike. Pri rezervaciji samo izaberite
        „Bašta“.
      </p>
      <a class="btn btn--basil garden__cta" href="#rezervacija" data-seating="basta">Rezerviši mesto u bašti</a>
    </div>
  </div>
</section>

<style>
  .garden__grid {
    display: grid;
    gap: var(--space-l);
    align-items: center;
  }
  .garden__art :global(.garden__photo) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-l);
  }
  .garden__placeholder {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 10;
    border-radius: var(--radius-l);
    background:
      radial-gradient(60% 70% at 78% 20%, rgb(255 248 220 / 0.9), transparent 70%),
      linear-gradient(160deg, var(--basil-soft), #c9d6bb);
    overflow: hidden;
  }
  .garden__placeholder :global(.garden__nest) {
    width: 46%;
  }
  .garden__placeholder :global(.garden__sun) {
    position: absolute;
    top: 12%;
    right: 12%;
    color: #b98a2c;
  }
  h2 {
    margin-block: var(--space-2xs) var(--space-s);
  }
  .garden__lead {
    max-width: var(--text-max);
    font-size: var(--fs-lead);
  }
  .garden__cta {
    margin-top: var(--space-m);
  }
  @media (min-width: 60rem) {
    .garden__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-xl);
    }
  }
</style>
