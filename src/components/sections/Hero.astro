---
import Logo from '../ui/Logo.astro';
import Photo from '../ui/Photo.astro';
import { business } from '../../data/business';

import { HERO_PHOTO, HERO_QUALITY, HERO_SIZES } from './hero-config';
---

<section class="hero theme-ink" id="top" aria-labelledby="hero-title">
  <div class="hero__media">
    <Photo
      file={HERO_PHOTO}
      alt="Tanjir domaćih taljatela sa mesom i pečurkama, posut rendanim sirom"
      sizes={HERO_SIZES}
      quality={HERO_QUALITY}
      priority
      class="hero__img"
    />
    <div class="hero__shade" aria-hidden="true"></div>
  </div>

  <div class="hero__content container">
    <div class="hero__logo" data-hero-logo>
      <Logo variant="full" id="hero-logo" label="Pastai — Hand made" />
    </div>
    <p class="eyebrow hero__eyebrow">Pasta bar · Trg republike · Novi Sad</p>
    <h1 id="hero-title">
      <span class="visually-hidden">Pastai Bar &amp; Restaurant: </span>{business.tagline}
    </h1>
    <p class="hero__lead">
      Domaća pasta u centru Novog Sada, na Trgu republike, u sklopu Riblje pijace.
    </p>
    <p class="status-pill" data-open-status data-state="pending" role="status" aria-live="polite">
      <span class="status-pill__dot" aria-hidden="true"></span>
      <span data-open-label>Otvoreno sada · zatvara se u 23:00</span>
    </p>
    <div class="hero__ctas">
      <a class="btn btn--primary" href="#rezervacija">Rezerviši</a>
      <a class="btn btn--ghost" href="#meni">Pogledaj meni</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: 100svh;
    padding-bottom: var(--space-xl);
    overflow: hidden;
  }
  .hero__media {
    position: relative;
    height: 42svh;
    min-height: 15rem;
    max-height: 26rem;
    overflow: hidden;
  }
  .hero__media :global(picture) {
    display: block;
    height: 100%;
  }
  .hero__media :global(.hero__img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(18 17 16 / 0.55) 0%, rgb(18 17 16 / 0) 30%),
      linear-gradient(0deg, var(--ink) 0%, rgb(18 17 16 / 0.6) 30%, rgb(18 17 16 / 0) 62%);
  }
  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    margin-top: -6.5rem;
  }
  .hero__logo {
    width: min(58vw, 15rem);
    color: var(--dough);
    margin-bottom: var(--space-s);
  }
  .hero__logo :global([data-part='emblem']) {
    color: var(--basil-on-ink);
  }
  :global(html.intro-on) .hero__logo {
    visibility: hidden;
  }
  .hero__eyebrow {
    margin-bottom: var(--space-2xs);
  }
  .hero__lead {
    max-width: 30rem;
    margin-top: var(--space-xs);
    color: var(--fg-muted);
    font-size: var(--fs-lead);
  }
  .status-pill {
    margin-top: var(--space-m);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-xs);
    margin-top: var(--space-m);
  }
  .hero__ctas .btn {
    min-width: 9.5rem;
  }

  @media (min-width: 60rem) {
    .hero {
      grid-template-columns: 1fr 1fr;
      align-items: center;
      padding: calc(var(--header-h) + var(--space-l)) 0 var(--space-xl);
    }
    .hero__media {
      order: 2;
      height: min(78vh, 46rem);
      max-height: none;
      width: min(100%, 30rem);
      justify-self: center;
      border-radius: 999px 999px var(--radius-l) var(--radius-l);
      overflow: hidden;
      box-shadow: var(--shadow-card);
    }
    .hero__shade {
      background: linear-gradient(0deg, rgb(18 17 16 / 0.35), rgb(18 17 16 / 0) 40%);
    }
    .hero__content {
      order: 1;
      align-items: flex-start;
      text-align: left;
      margin-top: 0;
      padding-left: max(var(--gutter), calc((100vw - var(--content-max)) / 2 + var(--gutter)));
    }
    .hero__logo {
      width: 17rem;
      margin-left: -0.5rem;
    }
    .hero__ctas {
      justify-content: flex-start;
    }
  }
</style>
