---
import Icon from '../ui/Icon.astro';
import { business, weekdayNames, weekOrder } from '../../data/business';

const { lat, lng } = business.geo;
const embed = `https://www.google.com/maps?q=${lat},${lng}&z=17&hl=sr&output=embed`;
---

<section class="section location theme-dough" id="lokacija" aria-labelledby="lokacija-title">
  <div class="container location__grid">
    <div class="location__info">
      <p class="eyebrow">Lokacija i kontakt</p>
      <h2 id="lokacija-title">Na Trgu republike, u Ribljoj pijaci</h2>

      <address class="location__address">
        <Icon name="pin" />
        <span>
          {business.address.street}, {business.address.postalCode} {business.address.city}
          <br /><span class="muted">{business.address.note} · {business.address.district}</span>
        </span>
      </address>

      <table class="hours" aria-label="Radno vreme">
        <tbody>
          {
            weekOrder.map((d) => {
              const h = business.hours[d];
              return (
                <tr data-day={d}>
                  <th scope="row">{weekdayNames[d]}</th>
                  <td>
                    {h.open}–{h.close}
                    {h.closesNextDay && <span class="hours__late">posle ponoći</span>}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
      <p class="status-pill location__status" data-open-status data-state="pending" aria-live="polite">
        <span class="status-pill__dot" aria-hidden="true"></span>
        <span data-open-label>Otvoreno sada</span>
      </p>

      <ul class="location__contact">
        <li><a href={business.phone.tel}><Icon name="phone" size={18} /> {business.phone.display}</a></li>
        <li><a href={business.phone.whatsapp} target="_blank" rel="noopener"><Icon name="chat" size={18} /> WhatsApp</a></li>
        <li><a href={business.links.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={18} /> @pastai.ns</a></li>
        <li><a href={business.links.facebook} target="_blank" rel="noopener"><Icon name="facebook" size={18} /> Facebook</a></li>
      </ul>
    </div>

    <div class="map">
      <div class="map__frame" data-map data-src={embed}>
        <!-- Styled placeholder: Google Maps loads only after a tap (no third-party requests up front). -->
        <svg class="map__art" viewBox="0 0 400 300" aria-hidden="true" preserveAspectRatio="xMidYMid slice">
          <rect width="400" height="300" fill="#E6D6B8"></rect>
          <g fill="none" stroke="#F2E8D5" stroke-linecap="round">
            <path d="M-10 210 140 150 260 170 420 110" stroke-width="16"></path>
            <path d="M120 -10 150 140 130 320" stroke-width="12"></path>
            <path d="M260 170 300 320M250 -10 260 170" stroke-width="10"></path>
            <path d="M-10 70 120 90 250 60 420 40M20 300 140 230M300 230 420 260" stroke-width="6"></path>
          </g>
          <rect x="166" y="150" width="70" height="48" rx="4" fill="#DCE5D2" stroke="#3E6B3A" stroke-opacity=".35"></rect>
          <g transform="translate(200 146)">
            <path d="M0 0c-14-14-20-24-20-33a20 20 0 0 1 40 0C20-24 14-14 0 0Z" fill="#C63A22"></path>
            <circle cy="-33" r="7" fill="#F2E8D5"></circle>
          </g>
        </svg>
        <button class="map__load btn btn--primary" type="button" data-map-load>
          <Icon name="pin" size={18} /> Prikaži mapu
        </button>
        <p class="map__note">Učitava Google mape</p>
      </div>
      <a class="btn btn--ghost map__open" href={business.links.googleMaps} target="_blank" rel="noopener">
        Otvori u Google mapama <Icon name="external" size={16} />
      </a>
    </div>
  </div>
</section>

<style>
  .location__grid {
    display: grid;
    gap: var(--space-l);
  }
  h2 {
    margin-block: var(--space-2xs) var(--space-m);
  }
  .location__address {
    display: flex;
    gap: var(--space-xs);
    font-style: normal;
    font-weight: 600;
  }
  .muted {
    font-weight: 400;
    color: var(--fg-muted);
  }
  .hours {
    width: 100%;
    margin-top: var(--space-m);
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .hours th,
  .hours td {
    padding: 0.5rem 0.6rem;
    border-bottom: 1px solid var(--rule);
    text-align: left;
    font-weight: 500;
  }
  .hours td {
    text-align: right;
  }
  .hours__late {
    margin-left: 0.4rem;
    font-size: var(--fs-micro);
    color: var(--fg-muted);
  }
  .hours tr.is-today {
    background: var(--basil-soft);
  }
  .hours tr.is-today th,
  .hours tr.is-today td {
    font-weight: 750;
    color: var(--basil-text);
  }
  .hours tr.is-today th::after {
    content: ' · danas';
    font-weight: 500;
  }
  .location__status {
    margin-top: var(--space-s);
  }
  .location__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs);
    margin: var(--space-m) 0 0;
    padding: 0;
    list-style: none;
  }
  .location__contact a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--tap-min);
    padding: 0 0.9rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    font-size: var(--fs-small);
    font-weight: 600;
    text-decoration: none;
  }
  .location__contact a:hover {
    border-color: var(--basil);
  }
  .map {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
  }
  .map__frame {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-l);
    overflow: hidden;
    background: var(--dough-deep);
    box-shadow: var(--shadow-dough);
  }
  .map__art,
  .map__frame :global(iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map__load {
    position: relative;
    margin-top: 6rem;
  }
  .map__note {
    position: absolute;
    bottom: 0.75rem;
    font-size: var(--fs-micro);
    color: var(--ink-muted);
  }
  .map__open {
    justify-self: start;
  }
  @media (min-width: 60rem) {
    .location__grid {
      grid-template-columns: 1fr 1.1fr;
      gap: var(--space-xl);
    }
  }
</style>

<script>
  const frame = document.querySelector<HTMLElement>('[data-map]')!;
  frame.querySelector('[data-map-load]')!.addEventListener('click', () => {
    const iframe = document.createElement('iframe');
    iframe.src = frame.dataset.src!;
    iframe.title = 'Mapa: Pastai, Trg republike 18, Novi Sad';
    iframe.loading = 'lazy';
    iframe.referrerPolicy = 'no-referrer-when-downgrade';
    iframe.allowFullscreen = true;
    frame.replaceChildren(iframe);
  });
</script>
