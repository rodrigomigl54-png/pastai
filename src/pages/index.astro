---
import BaseLayout from '../layouts/BaseLayout.astro';
import DoughDefs from '../components/ui/DoughDefs.astro';
import MotifSprite from '../components/menu/motifs/MotifSprite.astro';
import Intro from '../components/intro/Intro.astro';
import Header from '../components/sections/Header.astro';
import Hero from '../components/sections/Hero.astro';
import About from '../components/sections/About.astro';
import Specialty from '../components/sections/Specialty.astro';
import Menu from '../components/menu/Menu.astro';
import Gallery from '../components/sections/Gallery.astro';
import Garden from '../components/sections/Garden.astro';
import Events from '../components/sections/Events.astro';
import Reviews from '../components/sections/Reviews.astro';
import Reservation from '../components/sections/Reservation.astro';
import Delivery from '../components/sections/Delivery.astro';
import Location from '../components/sections/Location.astro';
import Footer from '../components/sections/Footer.astro';
import ActionBar from '../components/sections/ActionBar.astro';
import Thread from '../components/thread/Thread.astro';
import { restaurantSchema } from '../lib/schema';
import { getImage } from 'astro:assets';
import { getPhoto, widthsFor } from '../lib/photos';
import { HERO_PHOTO, HERO_QUALITY, HERO_SIZES } from '../components/sections/hero-config';

// Preload the hero (LCP) image so it is fetched before the parser reaches it.
const heroImg = getPhoto(HERO_PHOTO);
const heroAvif = await getImage({ src: heroImg, format: 'avif', widths: widthsFor(heroImg), quality: HERO_QUALITY, sizes: HERO_SIZES });

const title = 'Pastai Bar & Restaurant | Domaća pasta u centru Novog Sada';
const description =
  'Pasta bar na Trgu republike, u Ribljoj pijaci u Novom Sadu: domaća pasta, bašta i dostava. Rezervišite sto preko WhatsApp-a.';
---

<BaseLayout title={title} description={description} jsonLd={restaurantSchema()} intro>
  <link
    slot="head"
    rel="preload"
    as="image"
    type="image/avif"
    imagesrcset={heroAvif.srcSet.attribute}
    imagesizes={HERO_SIZES}
    fetchpriority="high"
  />
  <Intro />
  <Header />
  <main id="sadrzaj">
    <Thread />
    <Hero />
    <About />
    <Specialty />
    <Menu />
    <Gallery />
    <Garden />
    <Events />
    <Reviews />
    <Reservation />
    <Delivery />
    <Location />
  </main>
  <Footer />
  <ActionBar />
  <!-- Shared SVG defs last: keeps the hero early in the byte stream. -->
  <DoughDefs />
  <MotifSprite />
</BaseLayout>

<script>
  import { initOpenStatus } from '../scripts/open-status';
  initOpenStatus();
</script>
